# --- Fetched corpora --------------------------------------------------------
# Cached upstream response bodies. Not committed: they are large, they are not
# ours to redistribute, and the point is that the measurement is reproducible
# from the source register rather than from a snapshot we curated.
#   python3 tools/diavgeia.py --n 100 --refresh
#   python3 tools/rfc.py --n 12 --refresh
corpus/cache/

# --- Fuzzing ----------------------------------------------------------------
# Crashers are committed as regression fixtures; the working corpus is not.
fuzz/corpus/
fuzz/artifacts/
